{
    "name": "tcgunel/omnipay-odeal",
    "type": "library",
    "description": "Omnipay extension for Ödeal - 3D/Non-3D virtual POS payments, pay-by-link, cancel, refund and transaction queries",
    "keywords": [
        "odeal",
        "ödeal",
        "sanal pos",
        "virtual pos",
        "3d secure",
        "pay by link",
        "omnipay",
        "payment",
        "gateway"
    ],
    "homepage": "https://github.com/tcgunel/omnipay-odeal",
    "license": "MIT",
    "authors": [
        {
            "name": "Tolga Can Günel",
            "email": "tlgcngnl@gmail.com"
        },
        {
            "name": "Omnipay Contributors",
            "homepage": "https://github.com/tcgunel/omnipay-odeal/contributors"
        }
    ],
    "autoload": {
        "psr-4": {
            "Omnipay\\Odeal\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Omnipay\\Odeal\\Tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.3",
        "league/omnipay": "^3",
        "psr/log": "^2.0 || ^3.0",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9",
        "omnipay/tests": "^4",
        "brianium/paratest": "*",
        "fzaninotto/faker": "*",
        "laravel/pint": "^1.0",
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "test": "vendor/bin/paratest --processes 6",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "analyse": "vendor/bin/phpstan analyse",
        "lint": "vendor/bin/pint",
        "lint-check": "vendor/bin/pint --test"
    }
}
